                <mxCell id="insight-header" value="Key Architecture Insight" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontStyle=1;fontColor=#145a32;" parent="1" vertex="1">
