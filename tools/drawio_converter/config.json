{
  "_comment": "DrawIO to PowerPoint Converter Configuration",

  "work_area": {
    "width": 1100,
    "height": 600,
    "_description": "The rectangle where content will be placed. Agents fill this space."
  },

  "slide": {
    "width": 1200,
    "height": 675,
    "offset_x": 50,
    "offset_y": 40,
    "_description": "PowerPoint slide dimensions and content offset"
  },

  "spacing": {
    "min_gap": 10,
    "container_padding": 8,
    "section_gap": 15,
    "_description": "Minimum spacing rules between elements"
  },

  "priority": [
    "title",
    "subtitle",
    "main_containers",
    "modules",
    "arrows",
    "legend",
    "callouts"
  ],

  "overflow_strategy": "scale_down",

  "text": {
    "min_font_size": 6,
    "max_font_size": 24,
    "scale_factor": 0.85,
    "_description": "Font size constraints and scaling"
  },

  "style": {
    "no_shadows": true,
    "no_effects": true,
    "preserve_colors": true,
    "preserve_fonts": true
  }
}
