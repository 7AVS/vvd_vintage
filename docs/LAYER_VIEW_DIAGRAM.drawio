                <mxCell id="source-content" value="&lt;div style=&#39;text-align:left;padding:10px;font-size:12px&#39;&gt;&lt;b&gt;HIVE (Parquet):&lt;/b&gt;&lt;br&gt;• tactic_evnt_hist (experiment participants)&lt;br&gt;• VISA_DR_CRD (card data)&lt;br&gt;• POS_TXN (transaction data)&lt;br&gt;&lt;br&gt;&lt;b&gt;EDW (Teradata):&lt;/b&gt;&lt;br&gt;• TACTIC_EVNT_IP_AR_HIST (fulfillment)&lt;br&gt;• VENDOR_FEEDBACK (email engagement)&lt;br&gt;• CLNT_CRD_POS_LOG + TOKEN_LIST (tokens)&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
