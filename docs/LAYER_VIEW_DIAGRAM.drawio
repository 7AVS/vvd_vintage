                <mxCell id="count-header" value="59 Hardcoded Items (Today)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontStyle=1;fontColor=#7f6000;" parent="1" vertex="1">
