                <mxCell id="l3-today-code" value="&lt;pre style=&#39;text-align:left;font-size:10px;margin:10px;&#39;&gt;SUCCESS_DEFINITIONS = {&#xa;    &quot;card_acquisition&quot;: {&#xa;        &quot;description&quot;: &quot;Client acquired a&#xa;                        new VVD card&quot;,&#xa;        &quot;source&quot;: &quot;HIVE&quot;,&#xa;        &quot;table_path&quot;: &quot;/prod/.../VISA_DR_CRD/&quot;,&#xa;        &quot;date_field&quot;: &quot;ISS_DT&quot;,&#xa;        &quot;client_field&quot;: &quot;CLNT_NO&quot;,&#xa;        &quot;filters&quot;: {&#xa;            &quot;STS_CD&quot;: [&quot;06&quot;, &quot;08&quot;],&#xa;            &quot;SRVC_ID&quot;: 36,&#xa;            &quot;ISS_DT_NOT_NULL&quot;: True&#xa;        }&#xa;    },&#xa;    &quot;card_activation&quot;: {...},&#xa;    &quot;card_usage&quot;: {...},&#xa;    &quot;wallet_provisioning&quot;: {...}&#xa;}&lt;/pre&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontColor=#003168;" parent="1" vertex="1">
