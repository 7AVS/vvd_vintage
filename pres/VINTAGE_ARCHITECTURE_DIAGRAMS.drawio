                <mxCell id="l2-future-code" value="&lt;pre style=&#39;text-align:left;font-size:11px;margin:10px;color:#FFFFFF;&#39;&gt;SELECT&#xa;    primary_metric,&#xa;    secondary_metric,&#xa;    campaign_name,&#xa;    measurement_category&#xa;FROM CIDM_MNEMONIC_ATTRS&#xa;WHERE mne = &#39;VCN&#39;&#xa;&#xa;-- Returns the same info but from&#xa;-- governed metadata table&#xa;&#xa;When Mnemonic Mapping v2 has:&#xa;• Primary Metric field&#xa;• Secondary Metric field&#xa;• Tertiary Metric field&lt;/pre&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontColor=#FFFFFF;" parent="1" vertex="1">
