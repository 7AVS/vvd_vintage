        </mxCell>

        <!-- HIVE PATH -->
        <mxCell id="t-hive-path" value="&lt;b&gt;HIVE PATH&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:10px&quot;&gt;table_path: /prod/sz/...&lt;br&gt;filters: {STS_CD, SRVC_ID...}&lt;br&gt;apply_success_filters(df)&lt;/font&gt;&lt;br&gt;&lt;br&gt;&#10;&#8226; Read parquet via Spark&lt;br&gt;&#8226; Apply PySpark filters&lt;br&gt;&#8226; Extract client key" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=2;align=left;spacingLeft=10;spacingRight=10;verticalAlign=top;spacingTop=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="180" y="760" width="310" height="160" as="geometry" />
        </mxCell>
        <mxCell id="t-hive-label" value="source = &quot;HIVE&quot;" style="text;html=1;fillColor=#4CAF50;fontColor=#FFFFFF;align=center;verticalAlign=middle;rounded=1;fontSize=10;fontStyle=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="270" y="740" width="110" height="22" as="geometry" />
        </mxCell>

        <!-- EDW PATH -->
        <mxCell id="t-edw-path" value="&lt;b&gt;EDW PATH (Teradata)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:10px&quot;&gt;tables: [pos_log, token_list]&lt;br&gt;query: &quot;SELECT ... JOIN ... WHERE&quot;&lt;br&gt;business_rules: [...]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&#10;&#8226; Execute SQL via EDW cursor&lt;br&gt;&#8226; Full query IN the asset&lt;br&gt;&#8226; Rules documented alongside" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=2;align=left;spacingLeft=10;spacingRight=10;verticalAlign=top;spacingTop=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="710" y="760" width="310" height="160" as="geometry" />
        </mxCell>
        <mxCell id="t-edw-label" value="source = &quot;EDW&quot;" style="text;html=1;fillColor=#1565C0;fontColor=#FFFFFF;align=center;verticalAlign=middle;rounded=1;fontSize=10;fontStyle=1;spacingLeft=6;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="810" y="740" width="110" height="22" as="geometry" />
        </mxCell>

        <!-- Router arrows to paths -->
        <mxCell id="ta-router-hive" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#4CAF50;strokeWidth=2;" edge="1" source="t-router" target="t-hive-path" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ta-router-edw" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#1565C0;strokeWidth=2;" edge="1" source="t-router" target="t-edw-path" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- STANDARDIZED OUTPUT -->
        <mxCell id="t-std-output" value="&lt;b&gt;STANDARDIZED OUTPUT&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:12px&quot;&gt;CLNT_NO  |  SUCCESS_DT&lt;/font&gt;&lt;br&gt;&lt;br&gt;Same contract regardless of source.&lt;br&gt;This is what Module 4 and the Engine receive." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#003168;fontColor=#FFFFFF;strokeColor=#003168;strokeWidth=2;align=center;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="355" y="940" width="490" height="90" as="geometry" />
        </mxCell>

        <!-- Paths to standardized output -->
        <mxCell id="ta-hive-out" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#003168;strokeWidth=2;" edge="1" source="t-hive-path" target="t-std-output" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ta-edw-out" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#003168;strokeWidth=2;" edge="1" source="t-edw-path" target="t-std-output" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ARROW: Module 3 to Module 4 -->
        <mxCell id="ta5" value="&lt;font style=&quot;font-size:10px&quot;&gt;passes success_df&lt;br&gt;(CLNT_NO + SUCCESS_DT)&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#003168;strokeWidth=2;labelBackgroundColor=#FFFFFF;" edge="1" source="t-std-output" target="t-mod4" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- MODULE 4: CLIENT JOURNEY (CLEAN) -->
        <mxCell id="t-mod4" value="&lt;b&gt;MODULE 4: CLIENT JOURNEY&lt;/b&gt;   &lt;font color=&quot;#666666&quot;&gt;&quot;What actually happened?&quot;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&#10;&#8226; Joins experiment (M1) + success (M3) → &lt;font face=&quot;Courier New&quot;&gt;detect_success()&lt;/font&gt;&lt;br&gt;&#10;&#8226; Enriches with engagement data (email opens/clicks)&lt;br&gt;&#10;&lt;b&gt;Output: enriched success_df&lt;/b&gt; (standardized fields for engine)&lt;br&gt;&lt;br&gt;&#10;&lt;font color=&quot;#4CAF50&quot;&gt;&lt;b&gt;NOW CLEAN — no more Layer 3 logic here&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F3FF;strokeColor=#0091DA;strokeWidth=2;align=left;spacingLeft=15;spacingRight=15;verticalAlign=middle;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="250" y="1080" width="700" height="120" as="geometry" />
        </mxCell>
        <mxCell id="t-l4" value="M4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#0091DA;fontColor=#FFFFFF;strokeColor=#0091DA;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="250" y="1080" width="40" height="40" as="geometry" />
        </mxCell>

        <!-- ARROW: Module 4 to Engine -->
        <mxCell id="ta6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#003168;strokeWidth=2;" edge="1" source="t-mod4" target="t-engine" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ENGINE CORE -->
        <mxCell id="t-engine" value="&lt;b&gt;VINTAGE ENGINE (Unchanged)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:11px&quot;&gt;build_vintage_curves() → build_engagement_curves() → output&lt;/font&gt;&lt;br&gt;&lt;br&gt;Receives standardized DataFrames. Does not know or care about sources." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#003168;strokeWidth=3;align=center;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="320" y="1240" width="560" height="100" as="geometry" />
        </mxCell>

        <!-- OUTPUT -->
        <mxCell id="ta7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#003168;strokeWidth=2;" edge="1" source="t-engine" target="t-output" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t-output" value="&lt;b&gt;VINTAGE CURVES OUTPUT&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:10px&quot;&gt;MNE | COHORT | TST_GRP_CD | RPT_GRP_CD | METRIC | DAY | RATE&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#003168;fontColor=#FFFFFF;strokeColor=#003168;align=center;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="370" y="1380" width="460" height="60" as="geometry" />
        </mxCell>

        <!-- KEY INSIGHT BOX -->
        <mxCell id="t-insight" value="&lt;b&gt;KEY PRINCIPLE&lt;/b&gt;&lt;br&gt;&lt;br&gt;The MNE triggers the pipeline. Each module looks up what it needs for that mnemonic.&lt;br&gt;&lt;br&gt;Module 3 detects the source type (HIVE / EDW) and activates the right protocol.&lt;br&gt;If it has no EDW config → EDW path does not activate.&lt;br&gt;If it has no HIVE config → HIVE path does not activate.&lt;br&gt;&lt;br&gt;The output contract is always the same: &lt;font face=&quot;Courier New&quot;&gt;CLNT_NO + SUCCESS_DT&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F7FA;strokeColor=#07AFBF;strokeWidth=2;align=left;spacingLeft=15;spacingRight=15;verticalAlign=top;spacingTop=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="30" y="1080" width="200" height="260" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
