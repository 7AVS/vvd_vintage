                <mxCell id="count-content" value="&lt;table style=&#39;font-size:12px;border-collapse:collapse;width:90%;margin:auto&#39;&gt;&lt;tr&gt;&lt;td style=&#39;padding:4px&#39;&gt;Layer 1:&lt;/td&gt;&lt;td style=&#39;padding:4px&#39;&gt;3 items&lt;/td&gt;&lt;td style=&#39;padding:4px;color:#666&#39;&gt;(years, test code, path)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#39;padding:4px&#39;&gt;Layer 2:&lt;/td&gt;&lt;td style=&#39;padding:4px&#39;&gt;24 items&lt;/td&gt;&lt;td style=&#39;padding:4px;color:#666&#39;&gt;(6 campaigns × 4 fields)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#39;padding:4px&#39;&gt;Layer 3:&lt;/td&gt;&lt;td style=&#39;padding:4px&#39;&gt;24 items&lt;/td&gt;&lt;td style=&#39;padding:4px;color:#666&#39;&gt;(4 metrics × 6 fields)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#39;padding:4px&#39;&gt;Layer 4:&lt;/td&gt;&lt;td style=&#39;padding:4px&#39;&gt;8 items&lt;/td&gt;&lt;td style=&#39;padding:4px;color:#666&#39;&gt;(5 paths + 3 queries)&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;font-weight:bold;border-top:2px solid #d6b656&#39;&gt;&lt;td style=&#39;padding:6px 4px&#39;&gt;Total:&lt;/td&gt;&lt;td style=&#39;padding:6px 4px&#39;&gt;59 items&lt;/td&gt;&lt;td style=&#39;padding:6px 4px;color:#666&#39;&gt;→ become dynamic&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
